{
    "manifest_version": 3,
    "name": "PokeLinker | ポケモン徹底攻略にバトルデータベースへのリンクを追加",
    "version": "2.5",
    "description": "「ポケモン徹底攻略(SV/チャンピオンズ)」から「ポケモンバトルデータベース」へのリンクを生成、表示します。",
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://raw.githubusercontent.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": [
          "https://yakkun.com/sv/zukan/n*",
          "https://yakkun.com/ch/zukan/n*"
        ],
        "js": ["season-data.js", "content.js"]
      }
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self';"
    }
  }
